top_srcdir = @top_srcdir@
srcdir = @srcdir@
VPATH = @srcdir@
CPPFLAGS = -I${top_srcdir}/include -I../..
CFLAGS   = -g -Wall
LDFLAGS  =
CC = @CC@

# Legacy test programs (print-based, no assertions)
TESTPROGS = \
	ircd_chattr_t \
	ircd_in_addr_t \
	ircd_match_t \
	ircd_string_t

# CMocka test programs (proper assertions)
#
# @KC_CMOCKA_TESTPROGS@ is kc_url_cmocka kc_base64_cmocka kc_cache_cmocka ... webhook_subject_cmocka
# kc_jwt_cmocka kc_cred_derive_cmocka kc_error_classify_cmocka
# ircd_kc_adapter_cmocka under --enable-keycloak, and empty otherwise: the
# kc suites link ../kc/*.o, which ircd/Makefile only builds when Keycloak
# is enabled (see configure.in's Keycloak block), and the adapter's body is
# #ifdef USE_LIBKC.  Their build rules stay defined below either way; they
# are simply never requested.
#
# The EPOLL_CMOCKA_TESTPROGS substitution (configure.in) is
# ircd_events_cmocka and paste_listener_cmocka when the epoll engine is
# built, and empty otherwise: they link ../engine_epoll.o.
CMOCKA_TESTPROGS = \
	@KC_CMOCKA_TESTPROGS@ \
	@EPOLL_CMOCKA_TESTPROGS@ \
	ircd_chattr_cmocka \
	ircd_match_cmocka \
	ircd_string_cmocka \
	msgq_cmocka \
	ml_split_cmocka \
	numnicks_cmocka \
	ircd_in_addr_cmocka \
	ircd_compress_cmocka \
	ircd_cloaking_cmocka \
	dbuf_cmocka \
	ircd_crypt_cmocka \
	ircd_crypt_pbkdf2_cmocka \
	ircd_crypt_concurrency_cmocka \
	crule_cmocka \
	history_cmocka \
	history_trim_codec_cmocka \
	history_trim_cmocka \
	chathistory_presence_cmocka \
	chathistory_merge_cmocka \
	chathistory_recv_cmocka \
	pm_pair_index_cmocka \
	recv_classify_cmocka \
	ml_route_cmocka \
	nick_route_cmocka \
	ml_fallback_cmocka \
	send_s2s_tags_cmocka \
	register_throttle_cmocka \
	ipcheck_refund_cmocka \
	ipcheck_cmocka \
	fakelag_cmocka \
	nick_delay_cmocka \
	nick_request_cmocka \
	iauth_respawn_cmocka \
	webpush_mute_cmocka \
	webpush_expiry_cmocka \
	webpush_keyring_cmocka \
	webpush_attention_cmocka \
	bouncer_converge_cmocka \
	bouncer_wire_cmocka \
	bouncer_count_cmocka \
	bouncer_rebind_auth_cmocka \
	exit_reason_cmocka \
	bouncer_deauth_cmocka \
	bouncer_transplant_cmocka \
	sessid_index_cmocka \
	metadata_lww_cmocka \
	metadata_prereg_cmocka \
	bouncer_record_cmocka \
	webpush_line_cmocka \
	websocket_cmocka \
	db_casefold_cmocka \
	account_id_cmocka \
	rename_proto_cmocka \
	rename_handlers_cmocka \
	sasl_handler_cmocka \
	auth_recheck_cmocka \
	channel_speak_cmocka \
	dbuf_find_line_cmocka \
	input_hold_cmocka \
	s2s_handlers_cmocka \
	services_reply_cmocka \
	webhook_eventlog_cmocka \
	crdt_hlc_cmocka \
	db_api_fake_cmocka \
	db_api_rocksdb_cmocka \
	ssl_teardown_cmocka \
	close_connection_cmocka \
	send_tags_cmocka \
	log_async_cmocka \
	parse_line_cmocka \
	conf_reattach_cmocka \
	send_label_cmocka \
	ml_discard_cmocka

CMOCKA_LIBS = -lcmocka
ZSTD_LIBS = -lzstd
CURL_LIBS = -lcurl
JANSSON_LIBS = -ljansson
SSL_LIBS = -lssl -lcrypto
# The library configure found crypt() in (AC_SEARCH_LIBS: -lcrypt or
# -ldescrypt, or none where libc has it, as on macOS); GNU make's filter
# picks it out of the ircd's own link line.
CRYPT_LIBS = $(filter -lcrypt -ldescrypt,@LIBS@)
ROCKSDB_LIBS = -lrocksdb -lstdc++ -lpthread

DEP_SRC = \
	ircd_chattr_t.c \
	ircd_in_addr_t.c \
	ircd_match_t.c \
	ircd_string_t.c \
	ircd_chattr_cmocka.c \
	ircd_match_cmocka.c \
	ircd_string_cmocka.c \
	msgq_cmocka.c \
	ml_split_cmocka.c \
	numnicks_cmocka.c \
	ircd_in_addr_cmocka.c \
	ircd_compress_cmocka.c \
	ircd_cloaking_cmocka.c \
	dbuf_cmocka.c \
	ircd_crypt_cmocka.c \
	ircd_crypt_pbkdf2_cmocka.c \
	ircd_crypt_concurrency_cmocka.c \
	crule_cmocka.c \
	history_cmocka.c \
	history_trim_codec_cmocka.c \
	history_trim_cmocka.c \
	chathistory_presence_cmocka.c \
	chathistory_merge_cmocka.c \
	chathistory_recv_cmocka.c \
	pm_pair_index_cmocka.c \
	recv_classify_cmocka.c \
	ml_route_cmocka.c \
	nick_route_cmocka.c \
	ml_fallback_cmocka.c \
	send_s2s_tags_cmocka.c \
	register_throttle_cmocka.c \
	ipcheck_refund_cmocka.c \
	ipcheck_cmocka.c \
	fakelag_cmocka.c \
	nick_delay_cmocka.c \
	nick_request_cmocka.c \
	iauth_respawn_cmocka.c \
	webpush_mute_cmocka.c \
	webpush_expiry_cmocka.c \
	webpush_keyring_cmocka.c \
	webpush_attention_cmocka.c \
	bouncer_converge_cmocka.c \
	bouncer_wire_cmocka.c \
	bouncer_count_cmocka.c \
	bouncer_rebind_auth_cmocka.c \
	exit_reason_cmocka.c \
	bouncer_deauth_cmocka.c \
	bouncer_transplant_cmocka.c \
	sessid_index_cmocka.c \
	metadata_lww_cmocka.c \
	metadata_prereg_cmocka.c \
	bouncer_record_cmocka.c \
	webhook_eventlog_cmocka.c \
	webpush_line_cmocka.c \
	kc_url_cmocka.c \
	kc_base64_cmocka.c \
	kc_cache_cmocka.c \
	kc_jwt_cmocka.c \
	kc_cred_derive_cmocka.c \
	kc_error_classify_cmocka.c \
	ircd_kc_adapter_cmocka.c \
	websocket_cmocka.c \
	db_casefold_cmocka.c \
	account_id_cmocka.c \
	rename_proto_cmocka.c \
	rename_handlers_cmocka.c \
	sasl_handler_cmocka.c \
	auth_recheck_cmocka.c \
	channel_speak_cmocka.c \
	dbuf_find_line_cmocka.c \
	input_hold_cmocka.c \
	s2s_handlers_cmocka.c \
	services_reply_cmocka.c \
	webhook_subject_cmocka.c \
	kc_webhook_sig_cmocka.c \
	ircd_events_cmocka.c \
	paste_listener_cmocka.c \
	close_connection_cmocka.c \
	send_tags_cmocka.c \
	parse_line_cmocka.c \
	conf_reattach_cmocka.c \
	send_label_cmocka.c \
	ml_discard_cmocka.c \
	crdt_hlc_cmocka.c \
	db_api_cmocka.c \
	fake_db.c \
	test_stub.c

all: ${TESTPROGS}

build: ${TESTPROGS}

# Build CMocka tests separately (requires libcmocka-dev)
cmocka: ${CMOCKA_TESTPROGS}

depend: ${DEP_SRC}
	@cd ${srcdir} && \
	if [ -f Makefile.in.bak ]; then \
	  echo "make depend: First remove ircd/Makefile.in.bak"; \
	else \
	  mv Makefile.in Makefile.in.bak && \
	  grep -A1 -B10000 '^# DO NOT DELETE THIS LINE' Makefile.in.bak > Makefile.in && \
	  ${CC} ${CFLAGS} -MM ${CPPFLAGS} ${DEP_SRC} >> Makefile.in; \
	fi

install:

IRCD_CHATTR_T_OBJS = ircd_chattr_t.o test_stub.o ../ircd_string.o
ircd_chattr_t: $(IRCD_CHATTR_T_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_CHATTR_T_OBJS)

IRCD_IN_ADDR_T_OBJS = ircd_in_addr_t.o test_stub.o ../ircd_alloc.o ../ircd_string.o ../match.o ../numnicks.o
ircd_in_addr_t: $(IRCD_IN_ADDR_T_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_IN_ADDR_T_OBJS)

IRCD_MATCH_T_OBJS = ircd_match_t.o test_stub.o ../ircd_string.o ../match.o
ircd_match_t: $(IRCD_MATCH_T_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_MATCH_T_OBJS)

IRCD_STRING_T_OBJS = ircd_string_t.o test_stub.o ../ircd_string.o
ircd_string_t: $(IRCD_STRING_T_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_STRING_T_OBJS)

# CMocka tests - these use proper assertions
# All CMocka tests need test_stub.o for log_write/log_inassert stubs
IRCD_CHATTR_CMOCKA_OBJS = ircd_chattr_cmocka.o test_stub.o ../ircd_string.o
ircd_chattr_cmocka: $(IRCD_CHATTR_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_CHATTR_CMOCKA_OBJS) $(CMOCKA_LIBS)

IRCD_MATCH_CMOCKA_OBJS = ircd_match_cmocka.o test_stub.o ../ircd_string.o ../match.o
ircd_match_cmocka: $(IRCD_MATCH_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_MATCH_CMOCKA_OBJS) $(CMOCKA_LIBS)

IRCD_STRING_CMOCKA_OBJS = ircd_string_cmocka.o test_stub.o ../ircd_string.o
ircd_string_cmocka: $(IRCD_STRING_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_STRING_CMOCKA_OBJS) $(CMOCKA_LIBS)

# msgq_make()'s body cut (the client-line backstop under the relay's
# origin cut): the real msgq/ircd_snprintf/ircd_string/ircd_alloc, the
# rest stubbed in the test.
MSGQ_CMOCKA_OBJS = msgq_cmocka.o test_stub.o ../msgq.o ../ircd_snprintf.o \
	../ircd_string.o ../ircd_alloc.o
msgq_cmocka: $(MSGQ_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(MSGQ_CMOCKA_OBJS) $(CMOCKA_LIBS)

# ml_split_lines(): a multiline batch's long lines split into concat parts.
ML_SPLIT_CMOCKA_OBJS = ml_split_cmocka.o test_stub.o ../ml_split.o \
	../ircd_string.o ../ircd_alloc.o
ml_split_cmocka: $(ML_SPLIT_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(ML_SPLIT_CMOCKA_OBJS) $(CMOCKA_LIBS)

NUMNICKS_CMOCKA_OBJS = numnicks_cmocka.o test_stub.o ../numnicks.o ../ircd_string.o ../ircd_alloc.o ../match.o
numnicks_cmocka: $(NUMNICKS_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(NUMNICKS_CMOCKA_OBJS) $(CMOCKA_LIBS)

IRCD_IN_ADDR_CMOCKA_OBJS = ircd_in_addr_cmocka.o test_stub.o ../ircd_string.o ../match.o ../numnicks.o ../ircd_alloc.o
ircd_in_addr_cmocka: $(IRCD_IN_ADDR_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_IN_ADDR_CMOCKA_OBJS) $(CMOCKA_LIBS)

# ircd_compress tests - requires zstd library
IRCD_COMPRESS_CMOCKA_OBJS = ircd_compress_cmocka.o test_stub.o ../ircd_compress.o
ircd_compress_cmocka: $(IRCD_COMPRESS_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_COMPRESS_CMOCKA_OBJS) $(CMOCKA_LIBS) $(ZSTD_LIBS)

# ircd_cloaking tests - uses #include .c approach to access static functions
# Links against ircd_md5.o for MD5 hashing used in cloaking
IRCD_CLOAKING_CMOCKA_OBJS = ircd_cloaking_cmocka.o test_stub.o ../ircd_md5.o ../ircd_string.o
ircd_cloaking_cmocka: $(IRCD_CLOAKING_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_CLOAKING_CMOCKA_OBJS) $(CMOCKA_LIBS)

# dbuf tests - inlines dbuf.c with stubs for feature_int/bool/flush_connections
DBUF_CMOCKA_OBJS = dbuf_cmocka.o test_stub.o ../ircd_string.o
dbuf_cmocka: $(DBUF_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(DBUF_CMOCKA_OBJS) $(CMOCKA_LIBS)

# ircd_crypt tests - password hashing mechanisms
IRCD_CRYPT_CMOCKA_OBJS = ircd_crypt_cmocka.o test_stub.o ../ircd_string.o ../ircd_md5.o
ircd_crypt_cmocka: $(IRCD_CRYPT_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_CRYPT_CMOCKA_OBJS) $(CMOCKA_LIBS)

# ircd_crypt_pbkdf2 tests - base64 codec (sized decode, canary-guarded
# overflow regression) and the PBKDF2-SHA256/SHA512 hash/verify round
# trip.  Uses #include .c (like ircd_cloaking_cmocka.c) to reach the
# static base64_decode()/base64_encode()/parse_pbkdf2_*_hash(); needs
# SSL_LIBS for the real EVP_KDF/RAND_bytes calls in do_pbkdf2().
IRCD_CRYPT_PBKDF2_CMOCKA_OBJS = ircd_crypt_pbkdf2_cmocka.o test_stub.o
ircd_crypt_pbkdf2_cmocka: $(IRCD_CRYPT_PBKDF2_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_CRYPT_PBKDF2_CMOCKA_OBJS) $(CMOCKA_LIBS) $(SSL_LIBS)

# ircd_crypt_concurrency tests - password checks running at once (the
# async ones on the thread pool's workers, the synchronous ones on the main
# thread) never read each other's result from a mechanism's static buffer,
# and the async check frees the hash it computed.  Links the REAL
# ircd_crypt.o, ircd_crypt_async.o, thread_pool.o and every mechanism (so
# CRYPT_LIBS and SSL_LIBS); DoMalloc() lives in the test and free() is
# wrapped (--wrap=free) to count the blocks the ircd code holds.
IRCD_CRYPT_CONCURRENCY_CMOCKA_OBJS = ircd_crypt_concurrency_cmocka.o \
	../ircd_crypt.o ../ircd_crypt_async.o ../thread_pool.o \
	../ircd_crypt_plain.o ../ircd_crypt_smd5.o ../ircd_crypt_native.o \
	../ircd_crypt_bcrypt.o ../ircd_crypt_pbkdf2.o ../ircd_md5.o \
	../ircd_string.o
ircd_crypt_concurrency_cmocka: $(IRCD_CRYPT_CONCURRENCY_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) -Wl,--wrap=free $(IRCD_CRYPT_CONCURRENCY_CMOCKA_OBJS) $(CMOCKA_LIBS) $(CRYPT_LIBS) $(SSL_LIBS) -lpthread

# crule tests - connection rule parser (uses CR_DEBUG mode, includes crule.c)
CRULE_CMOCKA_OBJS = crule_cmocka.o test_stub.o ../ircd_string.o
crule_cmocka: $(CRULE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(CRULE_CMOCKA_OBJS) $(CMOCKA_LIBS)

# history tests - links the REAL record codec (history_record.o: serialize,
# deserialize, sentinel escaping, CH W forward encode/split); no database.
HISTORY_CMOCKA_OBJS = history_cmocka.o test_stub.o ../history_record.o ../ircd_snprintf.o ../ircd_alloc.o ../ircd_compress.o ../ircd_string.o ../redact_index.o
history_cmocka: $(HISTORY_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(HISTORY_CMOCKA_OBJS) $(CMOCKA_LIBS) $(ZSTD_LIBS)

# history_trim_codec tests - the pure key/record/owner-key codec for the
# chathistory trim project's by_time/by_owner indexes.  Links the real
# ../history_trim_codec.o plus ../db_casefold.o for db_casefold_bytes
# (fold helper) and ../ircd_string.o for the casemapping table db_casefold.o
# uses; fake_db.o satisfies only db_casefold.o's storage symbols (db_get,
# db_iter_*, db_writebatch_*, ...) that db_casefold_migrate references --
# no RocksDB, and this suite never calls that path.
HISTORY_TRIM_CODEC_CMOCKA_OBJS = history_trim_codec_cmocka.o test_stub.o ../history_trim_codec.o ../db_casefold.o ../ircd_string.o fake_db.o
history_trim_codec_cmocka: $(HISTORY_TRIM_CODEC_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(HISTORY_TRIM_CODEC_CMOCKA_OBJS) $(CMOCKA_LIBS)

# history_trim tests - the trim engine (index staging, the sliced boot
# accounting scan, budgeted slices, the one delete function, touched-target
# cleanup) against the in-memory storage fake: fake_db.o is the whole db_*
# backend here.  Links the real ../history_trim.o and its codec
# (../history_trim_codec.o, ../redact_index.o for the redact_index key,
# ../db_casefold.o + ../ircd_string.o for name folding, ../ircd_alloc.o
# for MyMalloc); test_stub.o supplies log_write.  No RocksDB.
HISTORY_TRIM_CMOCKA_OBJS = history_trim_cmocka.o test_stub.o ../history_trim.o \
	../history_trim_codec.o ../redact_index.o ../db_casefold.o ../ircd_string.o \
	../ircd_alloc.o fake_db.o
history_trim_cmocka: $(HISTORY_TRIM_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(HISTORY_TRIM_CMOCKA_OBJS) $(CMOCKA_LIBS)

# chathistory_presence tests - links the REAL chathistory_presence.o (built
# by the top-level `make` before this runs, same as ../ircd_string.o et al)
# to regression-test the uint8_t presence_record.count overflow fix
# (F-CH3).  db_*/history_get_env/feature_int/feature_bool are stubbed
# in chathistory_presence_cmocka.c itself since the in-memory
# session-anchored path under test never reaches the persistence layer.
CHATHISTORY_PRESENCE_CMOCKA_OBJS = chathistory_presence_cmocka.o test_stub.o ../chathistory_presence.o ../ircd_alloc.o ../ircd_string.o
chathistory_presence_cmocka: $(CHATHISTORY_PRESENCE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(CHATHISTORY_PRESENCE_CMOCKA_OBJS) $(CMOCKA_LIBS)

# chathistory_merge tests - the federated page merge (hm_merge: dedup,
# tag adoption, same-ms msgid order, trim direction, the heap-content
# hand-off to the copy) and its duplicate test (hm_find_dup).  Links the
# REAL ../chathistory_merge.o; history_free_messages is defined in the
# suite itself (history.c needs the store).
CHATHISTORY_MERGE_CMOCKA_OBJS = chathistory_merge_cmocka.o test_stub.o ../chathistory_merge.o ../ircd_alloc.o ../ircd_string.o
chathistory_merge_cmocka: $(CHATHISTORY_MERGE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(CHATHISTORY_MERGE_CMOCKA_OBJS) $(CMOCKA_LIBS)

# chathistory_recv tests - receive windows (W5 Task 8): what a peer
# relationship has already received of one channel's history
# federation, so a later request only pulls the gap.  The module is
# pure (no ircd deps); links the REAL ../chathistory_recv.o only, no
# test_stub.o.
CHATHISTORY_RECV_CMOCKA_OBJS = chathistory_recv_cmocka.o ../chathistory_recv.o
chathistory_recv_cmocka: $(CHATHISTORY_RECV_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(CHATHISTORY_RECV_CMOCKA_OBJS) $(CMOCKA_LIBS)

# pm_pair_index tests - the PM pairs each identity takes part in (W5
# Task 11: CHATHISTORY TARGETS finds a requester's own PM pairs without
# walking every target).  Links the REAL ../pm_pair_index.o against the
# in-memory store (fake_db.o is the whole db_* backend here), with
# ../db_casefold.o + ../ircd_string.o for the name folding; no RocksDB.
PM_PAIR_INDEX_CMOCKA_OBJS = pm_pair_index_cmocka.o test_stub.o ../pm_pair_index.o \
	../db_casefold.o ../ircd_string.o fake_db.o
pm_pair_index_cmocka: $(PM_PAIR_INDEX_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(PM_PAIR_INDEX_CMOCKA_OBJS) $(CMOCKA_LIBS)

# recv_classify tests - per-class recv-path byte classifier
RECV_CLASSIFY_CMOCKA_OBJS = recv_classify_cmocka.o test_stub.o ../recv_classify.o
recv_classify_cmocka: $(RECV_CLASSIFY_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(RECV_CLASSIFY_CMOCKA_OBJS) $(CMOCKA_LIBS)

# ml_route tests - ml_route_carries_multiline(), the test the originating
# server of a multiline batch decides by (ML batch or single-line
# fallback), over hand-built server trees.  Links the REAL ../ml_route.o
# only: the suite defines &me itself and the module calls nothing.
ML_ROUTE_CMOCKA_OBJS = ml_route_cmocka.o ../ml_route.o
ml_route_cmocka: $(ML_ROUTE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(ML_ROUTE_CMOCKA_OBJS) $(CMOCKA_LIBS)

# nick_route tests - the BX W route walk, linked as it is, and the pure
# rules beside it in bouncer_wire.c
NICK_ROUTE_CMOCKA_OBJS = nick_route_cmocka.o ../nick_route.o bouncer_wire_test.o
nick_route_cmocka: $(NICK_ROUTE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(NICK_ROUTE_CMOCKA_OBJS) $(CMOCKA_LIBS)

# ml_fallback tests - the one rule for a multiline fallback's preview and
# its "[N more lines]" count (blank lines neither shown nor counted).
# Links the REAL ../ml_fallback.o only (pure).
ML_FALLBACK_CMOCKA_OBJS = ml_fallback_cmocka.o ../ml_fallback.o
ml_fallback_cmocka: $(ML_FALLBACK_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(ML_FALLBACK_CMOCKA_OBJS) $(CMOCKA_LIBS)

# send_s2s_tags tests - the S2S compact tag region send.c builds for the
# multiline fallback mark ,F: placed before the terminal ,C, consumed, put
# on lines toward an IRCv3-aware link, cleared toward a legacy link or with
# P10_MESSAGE_TAGS off.  Includes the real send.c, compiled with
# -ffunction-sections and linked with --gc-sections; what the kept code
# reaches is stubbed in the suite (no test_stub.o).
send_s2s_tags_cmocka.o: ${srcdir}/send_s2s_tags_cmocka.c ../send.c
	${CC} ${CFLAGS} -ffunction-sections -fdata-sections ${CPPFLAGS} -c -o $@ ${srcdir}/send_s2s_tags_cmocka.c

SEND_S2S_TAGS_CMOCKA_OBJS = send_s2s_tags_cmocka.o
send_s2s_tags_cmocka: $(SEND_S2S_TAGS_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) -Wl,--gc-sections $(SEND_S2S_TAGS_CMOCKA_OBJS) $(CMOCKA_LIBS)

# register_throttle tests - the module is recompiled with a 1-bucket,
# 4-slot table so eviction is reachable without hash-collision gymnastics.
# No test_stub.o: the module is pure by design (no log_write, no ircd deps).
register_throttle_test.o: ../register_throttle.c ../../include/register_throttle.h
	${CC} ${CFLAGS} ${CPPFLAGS} -DREG_THROTTLE_TABLE_BITS=0 -DREG_THROTTLE_BUCKET_DEPTH=4 -c -o $@ ../register_throttle.c

REGISTER_THROTTLE_CMOCKA_OBJS = register_throttle_cmocka.o register_throttle_test.o
register_throttle_cmocka: $(REGISTER_THROTTLE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(REGISTER_THROTTLE_CMOCKA_OBJS) $(CMOCKA_LIBS)

# ipcheck_refund tests - the module is recompiled with a 1-bucket, 2-slot
# table so a full bucket is reachable with arbitrary account names.
# No test_stub.o: the module is pure by design (no log_write, no ircd deps).
ipcheck_refund_test.o: ../ipcheck_refund.c ../../include/ipcheck_refund.h
	${CC} ${CFLAGS} ${CPPFLAGS} -DIPCHECK_REFUND_TABLE_BITS=0 -DIPCHECK_REFUND_BUCKET_DEPTH=2 -c -o $@ ../ipcheck_refund.c

# IPcheck tests - the real IPcheck.c, with assert() routed to CMocka's
# mock_assert() (mock_assert.h) so a test can see an assert fire; the ircd
# services it calls (features, timers, the clock, the log, the registration
# NOTICE) are stubbed in ipcheck_cmocka.c itself, test_stub.o's debug()
# included, which would print every Debug() line.
ipcheck_test.o: ../IPcheck.c ../../include/IPcheck.h mock_assert.h
	${CC} ${CFLAGS} ${CPPFLAGS} -include ${srcdir}/mock_assert.h -c -o $@ ../IPcheck.c

IPCHECK_CMOCKA_OBJS = ipcheck_cmocka.o ipcheck_test.o \
	../ipcheck_refund.o ../ircd_alloc.o ../ircd_snprintf.o ../ircd_string.o \
	../match.o
ipcheck_cmocka: $(IPCHECK_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IPCHECK_CMOCKA_OBJS) $(CMOCKA_LIBS)

IPCHECK_REFUND_CMOCKA_OBJS = ipcheck_refund_cmocka.o ipcheck_refund_test.o
ipcheck_refund_cmocka: $(IPCHECK_REFUND_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IPCHECK_REFUND_CMOCKA_OBJS) $(CMOCKA_LIBS)

# fake-lag credit: header-only (include/fakelag.h)
FAKELAG_CMOCKA_OBJS = fakelag_cmocka.o
fakelag_cmocka: $(FAKELAG_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(FAKELAG_CMOCKA_OBJS) $(CMOCKA_LIBS)

# NICKDELAY rule: header-only (include/nick_delay.h)
NICK_DELAY_CMOCKA_OBJS = nick_delay_cmocka.o
nick_delay_cmocka: $(NICK_DELAY_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(NICK_DELAY_CMOCKA_OBJS) $(CMOCKA_LIBS)

# nick change meeting a holder: header-only (include/nick_request.h)
NICK_REQUEST_CMOCKA_OBJS = nick_request_cmocka.o
nick_request_cmocka: $(NICK_REQUEST_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(NICK_REQUEST_CMOCKA_OBJS) $(CMOCKA_LIBS)

# IAuth respawn backoff: header-only (include/iauth_respawn.h)
IAUTH_RESPAWN_CMOCKA_OBJS = iauth_respawn_cmocka.o
iauth_respawn_cmocka: $(IAUTH_RESPAWN_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IAUTH_RESPAWN_CMOCKA_OBJS) $(CMOCKA_LIBS)

# kc_url tests - vendored libkc URL builders.  kc_url.c calls
# curl_easy_escape in kc_url_group_by_path, hence -lcurl.  The test
# stubs kc_get_log_ops itself so kc.o (and the whole HTTP stack) stays
# out of the link.
KC_URL_CMOCKA_OBJS = kc_url_cmocka.o ../kc/kc_url.o
kc_url_cmocka: $(KC_URL_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(KC_URL_CMOCKA_OBJS) $(CMOCKA_LIBS) $(CURL_LIBS)

# kc_base64 tests - vendored libkc base64 codec (no libkc deps)
KC_BASE64_CMOCKA_OBJS = kc_base64_cmocka.o ../kc/kc_base64.o
kc_base64_cmocka: $(KC_BASE64_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(KC_BASE64_CMOCKA_OBJS) $(CMOCKA_LIBS)

# kc_cache tests - vendored libkc user-id and user-representation caches
KC_CACHE_CMOCKA_OBJS = kc_cache_cmocka.o ../kc/kc_cache.o
kc_cache_cmocka: $(KC_CACHE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(KC_CACHE_CMOCKA_OBJS) $(CMOCKA_LIBS) $(JANSSON_LIBS)

# kc_jwt tests - claim policy (F-K3 exp/nbf).  Uses the #include .c
# approach to reach static jwt_parse_claims, so ../kc/kc_jwt.o must NOT
# be linked (duplicate symbols).  kc_http_sync.o satisfies the JWKS
# fetch reference, which no test actually calls.
KC_JWT_CMOCKA_OBJS = kc_jwt_cmocka.o ../kc/kc_base64.o ../kc/kc_http_sync.o
kc_jwt_cmocka: $(KC_JWT_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(KC_JWT_CMOCKA_OBJS) $(CMOCKA_LIBS) $(JANSSON_LIBS) $(CURL_LIBS) $(SSL_LIBS)

# kc_cred_derive tests - registration-time SCRAM-SHA-256 + Keycloak PBKDF2
# credential derivation.  Pure derivation code (no HTTP), so only
# kc_base64.o is needed alongside kc_cred_derive.o itself.
KC_CRED_DERIVE_CMOCKA_OBJS = kc_cred_derive_cmocka.o ../kc/kc_cred_derive.o ../kc/kc_base64.o
kc_cred_derive_cmocka: $(KC_CRED_DERIVE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(KC_CRED_DERIVE_CMOCKA_OBJS) $(CMOCKA_LIBS) $(JANSSON_LIBS) $(SSL_LIBS)

# kc_error_classify tests - ROPC 400/401 grant-error body classifier
# (KC_UNVERIFIED vs KC_FORBIDDEN). Pure jansson logic, no HTTP.
KC_ERROR_CLASSIFY_CMOCKA_OBJS = kc_error_classify_cmocka.o ../kc/kc_error_classify.o
kc_error_classify_cmocka: $(KC_ERROR_CLASSIFY_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(KC_ERROR_CLASSIFY_CMOCKA_OBJS) $(CMOCKA_LIBS) $(JANSSON_LIBS)

# ircd_kc_adapter tests - libkc's socket and timer bridge onto the event
# engine.  The event layer is a fake in the test with the kernel's fd
# semantics (lowest free number on open, epoll registrations keyed by the
# number and dropped on close), so an engine call made with a number libkc
# already gave back is observable.  No libkc objects are linked; libcrypto
# is, for the OpenSSL error-queue drain after each call into libkc.
IRCD_KC_ADAPTER_CMOCKA_OBJS = ircd_kc_adapter_cmocka.o test_stub.o ../ircd_kc_adapter.o
ircd_kc_adapter_cmocka: $(IRCD_KC_ADAPTER_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_KC_ADAPTER_CMOCKA_OBJS) $(CMOCKA_LIBS) $(SSL_LIBS)
# websocket tests - frame decoding and handshake accumulation (#98, #99).
# Includes websocket.c directly with stubs; needs OpenSSL for the accept key.
WEBSOCKET_CMOCKA_OBJS = websocket_cmocka.o test_stub.o ../ircd_alloc.o ../ircd_string.o
websocket_cmocka: $(WEBSOCKET_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(WEBSOCKET_CMOCKA_OBJS) $(CMOCKA_LIBS) $(SSL_LIBS)

# db_casefold tests - key folding and the one-time key rewrite.  The
# store is an in-memory fake defined in the test (sorted rows, snapshot
# iterators, ordered batches), so only db_casefold.o and the casemapping
# table are linked; no RocksDB.
DB_CASEFOLD_CMOCKA_OBJS = db_casefold_cmocka.o test_stub.o ../db_casefold.o ../ircd_string.o
db_casefold_cmocka: $(DB_CASEFOLD_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(DB_CASEFOLD_CMOCKA_OBJS) $(CMOCKA_LIBS)

# account_id tests - the compact Keycloak user id codec (pure; links the
# webpush base64url helpers it reuses)
ACCOUNT_ID_CMOCKA_OBJS = account_id_cmocka.o ../account_id.o ../webpush_keyring.o
account_id_cmocka: $(ACCOUNT_ID_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(ACCOUNT_ID_CMOCKA_OBJS) $(CMOCKA_LIBS)

# rename_proto tests - the argument-only parts of channel RENAME: the
# services query cookie codec ("<numeric>.<n>") and the rules a rename's
# two names must pass.  Pure apart from the character tables and string
# checks in ircd_string.o (whose asserts want test_stub.o's log stubs).
RENAME_PROTO_CMOCKA_OBJS = rename_proto_cmocka.o test_stub.o ../rename_proto.o \
	../ircd_string.o
rename_proto_cmocka: $(RENAME_PROTO_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(RENAME_PROTO_CMOCKA_OBJS) $(CMOCKA_LIBS)

# rename_handlers tests - channel RENAME's handlers against a fake
# network: the REAL m_rename.o, rename_proto.o, numnicks.o and the ircd's
# printf (so the lines asserted are the lines that go on the wire), with
# the send layer, the channel table and the timers stubbed in the test.
# Defines its own log_write()/me, so test_stub.o is not linked.
RENAME_HANDLERS_CMOCKA_OBJS = rename_handlers_cmocka.o ../m_rename.o \
	../rename_proto.o ../numnicks.o ../ircd_snprintf.o ../ircd_string.o \
	../ircd_alloc.o ../match.o
rename_handlers_cmocka: $(RENAME_HANDLERS_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(RENAME_HANDLERS_CMOCKA_OBJS) $(CMOCKA_LIBS)

# sasl_handler tests - what AUTHENTICATE answers its parser when the SASL
# exchange ends inside it, and where a Keycloak answer lets registration go
# on: the REAL sasl_auth.o, m_authenticate.o and m_register.o, with the
# registration hold, the event loop, the send layer and libkc faked in the
# test (the Keycloak cases are #ifdef USE_LIBKC).  SSL_LIBS for the real
# SCRAM and ECDSA checks.  Defines its own log_write()/me, so test_stub.o
# is not linked.  The real bouncer_rebind_auth.o (pure) decides whether
# two Keycloak ids conflict.
SASL_HANDLER_CMOCKA_OBJS = sasl_handler_cmocka.o ../sasl_auth.o \
	../m_authenticate.o ../m_register.o ../ircd_string.o ../ircd_alloc.o \
	../account_id.o ../webpush_keyring.o ../bouncer_rebind_auth.o
sasl_handler_cmocka: $(SASL_HANDLER_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(SASL_HANDLER_CMOCKA_OBJS) $(CMOCKA_LIBS) $(SSL_LIBS)

# auth_recheck tests - the registration checks a Keycloak answer owes run
# from the event loop's timer pass, once, for requests still there.  The
# test includes the real s_auth.c, compiled with -ffunction-sections and
# linked with --gc-sections (the program keeps what the queue's code
# reaches; that world is stubbed in the test), with the real event core
# and this build's engines (@ENGINE_C@), so the timer pass and the engine
# loop's order are the server's own.  -Wno-address: s_auth.c tests array
# members against NULL, which -Wall reports (the ircd's own build has no
# -Wall).  timer_add is wrapped to count the queue timer's arms.
AUTH_RECHECK_ENGINE_OBJS = $(patsubst %.c,../%.o,@ENGINE_C@)
AUTH_RECHECK_CMOCKA_OBJS = auth_recheck_cmocka.o ../ircd_events.o \
	$(AUTH_RECHECK_ENGINE_OBJS) ../ircd_alloc.o ../ircd_string.o
auth_recheck_cmocka.o: ${srcdir}/auth_recheck_cmocka.c ../s_auth.c
	${CC} ${CFLAGS} -Wno-address -ffunction-sections -fdata-sections ${CPPFLAGS} -c -o $@ ${srcdir}/auth_recheck_cmocka.c

auth_recheck_cmocka: $(AUTH_RECHECK_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) -Wl,--gc-sections -Wl,--wrap=timer_add $(AUTH_RECHECK_CMOCKA_OBJS) $(CMOCKA_LIBS)
# channel_speak tests - may a bouncer device of ours speak in a channel
# (by its primary's face and membership; +Z by its own connection): the
# REAL predicates.  The test includes channel.c, compiled with
# -ffunction-sections and linked with --gc-sections, so the program keeps
# client_can_send_to_channel(), member_can_send_to_channel(), find_ban(),
# make_ban() and what they call; the rest of the ircd they reach is
# stubbed in the test.  -Wno-address as for auth_recheck.
CHANNEL_SPEAK_CMOCKA_OBJS = channel_speak_cmocka.o ../match.o ../ircd_string.o \
	../ircd_snprintf.o ../ircd_alloc.o
channel_speak_cmocka.o: ${srcdir}/channel_speak_cmocka.c ../channel.c
	${CC} ${CFLAGS} -Wno-address -ffunction-sections -fdata-sections ${CPPFLAGS} -c -o $@ ${srcdir}/channel_speak_cmocka.c

channel_speak_cmocka: $(CHANNEL_SPEAK_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) -Wl,--gc-sections $(CHANNEL_SPEAK_CMOCKA_OBJS) $(CMOCKA_LIBS)

# dbuf_find_line tests - a receive queue's first complete line a matcher
# accepts, found without removing anything (the orphan hold's QUIT scan):
# the REAL dbuf.c, included, with the pool, allocator and flusher stubbed.
DBUF_FIND_LINE_CMOCKA_OBJS = dbuf_find_line_cmocka.o ../ircd_alloc.o ../ircd_string.o
dbuf_find_line_cmocka.o: ${srcdir}/dbuf_find_line_cmocka.c ../dbuf.c
	${CC} ${CFLAGS} -ffunction-sections -fdata-sections ${CPPFLAGS} -c -o $@ ${srcdir}/dbuf_find_line_cmocka.c

dbuf_find_line_cmocka: $(DBUF_FIND_LINE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) -Wl,--gc-sections $(DBUF_FIND_LINE_CMOCKA_OBJS) $(CMOCKA_LIBS)

# input_hold tests - the orphan hold's pure rules (ircd/input_hold.c):
# hold, the bound's sweep request, release, the receive allowance, QUIT.
INPUT_HOLD_CMOCKA_OBJS = input_hold_cmocka.o input_hold_test.o
input_hold_test.o: ../input_hold.c
	${CC} ${CFLAGS} ${CPPFLAGS} -c -o $@ ../input_hold.c
input_hold_cmocka: $(INPUT_HOLD_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(INPUT_HOLD_CMOCKA_OBJS) $(CMOCKA_LIBS)

# s2s_handlers tests - server-to-server handlers against a fake network:
# the REAL m_burst.o, m_destruct.o, m_endburst.o, m_svsnick.o, m_svsquit.o
# and m_topic.o, with numnicks.o, match.o and the ircd's printf (so the lines asserted are the lines that go on the wire);
# the send layer, the channel table, the client hash and the modebuf are
# stubbed in the test.  Defines its own log_write()/me, so test_stub.o is
# not linked.
S2S_HANDLERS_CMOCKA_OBJS = s2s_handlers_cmocka.o ../m_burst.o ../m_destruct.o \
	../m_endburst.o ../m_svsnick.o \
	../m_svsquit.o ../m_topic.o \
	../numnicks.o ../ircd_snprintf.o ../ircd_string.o ../ircd_alloc.o \
	../match.o
s2s_handlers_cmocka: $(S2S_HANDLERS_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(S2S_HANDLERS_CMOCKA_OBJS) $(CMOCKA_LIBS)

# services_reply tests - which local client a services reply reaches and
# what it does to it: the REAL m_account.o and m_sasl.o, with numnicks.o
# and the ircd's printf; everything else they call is stubbed in the test.
# Defines its own log_write()/me, so test_stub.o is not linked.
SERVICES_REPLY_CMOCKA_OBJS = services_reply_cmocka.o ../m_account.o ../m_sasl.o \
	../numnicks.o ../ircd_snprintf.o ../ircd_string.o ../ircd_alloc.o \
	../match.o
services_reply_cmocka: $(SERVICES_REPLY_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(SERVICES_REPLY_CMOCKA_OBJS) $(CMOCKA_LIBS)

# webhook_subject tests - the pure webhook subject decision over real
# Keycloak admin-event shapes (fixtures/webhook); links no ircd objects
WEBHOOK_SUBJECT_CMOCKA_OBJS = webhook_subject_cmocka.o ../webhook_subject.o ../account_id.o ../webpush_keyring.o
webhook_subject_cmocka.o: ${srcdir}/webhook_subject_cmocka.c
	${CC} ${CFLAGS} ${CPPFLAGS} -DWEBHOOK_FIXTURE_DIR='"${srcdir}/fixtures/webhook"' -c -o $@ ${srcdir}/webhook_subject_cmocka.c
webhook_subject_cmocka: $(WEBHOOK_SUBJECT_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(WEBHOOK_SUBJECT_CMOCKA_OBJS) $(CMOCKA_LIBS) $(JANSSON_LIBS)

# kc_webhook_sig tests - signature verification and the replay ring (pure; OpenSSL)
KC_WEBHOOK_SIG_CMOCKA_OBJS = kc_webhook_sig_cmocka.o ../kc/kc_webhook_sig.o
kc_webhook_sig_cmocka: $(KC_WEBHOOK_SIG_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(KC_WEBHOOK_SIG_CMOCKA_OBJS) $(CMOCKA_LIBS) $(SSL_LIBS)

# ircd_events tests - an engine error never runs a socket's callback
# inside the socket_add/socket_events/socket_state call that caused it.
# Links the real event core and epoll engine, and makes real epoll calls
# fail; the few ircd symbols around them are stubbed in the test.  The
# event core is compiled with its assert() routed to the test
# (events_assert.h), so a case can see an assert fire, or run past it as a
# release build does.  epoll_ctl() is wrapped so a case can make the engine
# refuse the signal pipe at start-up.
ircd_events_test.o: ../ircd_events.c ../../include/ircd_events.h events_assert.h
	${CC} ${CFLAGS} ${CPPFLAGS} -include ${srcdir}/events_assert.h -c -o $@ ../ircd_events.c

IRCD_EVENTS_CMOCKA_OBJS = ircd_events_cmocka.o test_stub.o ircd_events_test.o ../engine_epoll.o
ircd_events_cmocka: $(IRCD_EVENTS_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) -Wl,--wrap=epoll_ctl $(IRCD_EVENTS_CMOCKA_OBJS) $(CMOCKA_LIBS)

# paste_listener tests - a paste connection is freed only by the last
# ET_DESTROY of the two event generators inside it (its socket and its
# request timer), never while one is still in use: a request timeout, a
# failed handshake, a hangup, a refused registration, shutdown, a served
# request and a WebSocket promote; and it holds a reference on its Listener
# until it closes, across a rehash that drops the port.  Includes
# ../paste_listener.c (so the test sees the conn when it is freed) and
# links the real event core (ircd_events_test.o, as above) and epoll
# engine; the TLS cases run a real handshake over a socketpair, hence
# libssl.
paste_listener_cmocka.o: ${srcdir}/paste_listener_cmocka.c ../paste_listener.c
	${CC} ${CFLAGS} ${CPPFLAGS} -c -o $@ ${srcdir}/paste_listener_cmocka.c

PASTE_LISTENER_CMOCKA_OBJS = paste_listener_cmocka.o ircd_events_test.o \
	../engine_epoll.o ../ircd_string.o
paste_listener_cmocka: $(PASTE_LISTENER_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(PASTE_LISTENER_CMOCKA_OBJS) $(CMOCKA_LIBS) $(SSL_LIBS)

# log_async tests - the async log writer never writes to a descriptor the
# log has closed: log_close() and log_file_destroy() drain the queue first,
# and log_async_flush() waits for the write in flight; and after
# log_shutdown() nothing reopens a log until log_resume().  Links the real
# ircd_log.o and ircd_log_async.o; the writer thread's write() is wrapped
# (--wrap=write) behind a gate the cases open, to hold a write in flight.
LOG_ASYNC_CMOCKA_OBJS = log_async_cmocka.o ../ircd_log.o ../ircd_log_async.o \
	../ircd_snprintf.o ../ircd_string.o ../ircd_alloc.o
log_async_cmocka: $(LOG_ASYNC_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) -Wl,--wrap=write $(LOG_ASYNC_CMOCKA_OBJS) $(CMOCKA_LIBS) -lpthread

# ssl_teardown tests - a TLS teardown writes only to a descriptor its
# socket still owns (ssl_abort after an ET_ERROR EBADF dropped cli_fd) and
# never reads the peer's stream (a one-way close_notify, so a drain that
# stopped inside a record cannot desync it).  Links the real ssl.o; the
# sessions are real handshakes over socketpairs, hence libssl.
SSL_TEARDOWN_CMOCKA_OBJS = ssl_teardown_cmocka.o ../ssl.o ../ircd_string.o \
	../ircd_snprintf.o ../ircd_alloc.o
ssl_teardown_cmocka: $(SSL_TEARDOWN_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(SSL_TEARDOWN_CMOCKA_OBJS) $(CMOCKA_LIBS) $(SSL_LIBS)

# close_connection tests - a closed user socket tells iauth the client is
# gone ("<fd> D") while the descriptor is still the client's, whichever
# path closed it (exit_client, a bouncer hold, BX X); a held ghost's exit
# (no descriptor) and a server link send nothing.  Includes ../s_bsd.c,
# compiled with -ffunction-sections and linked with --gc-sections: the
# program keeps close_connection() and what it calls, so only those are
# stubbed in the test, not everything else s_bsd.c reaches.
close_connection_cmocka.o: ${srcdir}/close_connection_cmocka.c ../s_bsd.c
	${CC} ${CFLAGS} -ffunction-sections -fdata-sections ${CPPFLAGS} -c -o $@ ${srcdir}/close_connection_cmocka.c

# The orphan hold's pure rules (close_connection() forgets a hold) are
# the real ones.
close_connection_cmocka: close_connection_cmocka.o input_hold_test.o
	${CC} -o $@ $(LDFLAGS) -Wl,--gc-sections close_connection_cmocka.o input_hold_test.o $(CMOCKA_LIBS)

# send_tags tests - the tag region a channel fan-out builds for each member
# (format_message_tags_ex() into 128 bytes) is well formed and stays in its
# buffer: no "@ " region when no tag applies (account-tag only, a source
# with no account), every tag whole or not at all, and a long draft/oper
# value falls back to the bare tag.  Includes ../send.c, compiled with
# -ffunction-sections and linked with --gc-sections; every line sent is
# captured at msgq_add().
send_tags_cmocka.o: ${srcdir}/send_tags_cmocka.c ../send.c
	${CC} ${CFLAGS} -ffunction-sections -fdata-sections ${CPPFLAGS} -c -o $@ ${srcdir}/send_tags_cmocka.c

SEND_TAGS_CMOCKA_OBJS = send_tags_cmocka.o ../ircd_snprintf.o ../ircd_string.o
send_tags_cmocka: $(SEND_TAGS_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) -Wl,--gc-sections $(SEND_TAGS_CMOCKA_OBJS) $(CMOCKA_LIBS)

# parse_line tests - a line that ends after its tags or its source prefix
# ("@x ", "@A<time><msgid> ", ":prefix ", "AC ") is parsed from its own
# bytes only: never from what a longer earlier line left after its
# terminator in the reused input buffer (parse_server stepped over the NUL
# and ran the earlier line's tail).  Includes ../parse.c, compiled with
# -ffunction-sections and linked with --gc-sections: the program keeps
# parse_server(), parse_client() and what they call, not the message table
# and its handlers, so only those are stubbed in the test.
# ../ircd_string.o supplies the character table msg_tree_parse() reads.
parse_line_cmocka.o: ${srcdir}/parse_line_cmocka.c ../parse.c
	${CC} ${CFLAGS} -ffunction-sections -fdata-sections ${CPPFLAGS} -c -o $@ ${srcdir}/parse_line_cmocka.c

# The orphan hold's pure rules (parse_client() asks whether a PONG is free).
PARSE_LINE_CMOCKA_OBJS = parse_line_cmocka.o ../ircd_string.o input_hold_test.o
parse_line_cmocka: $(PARSE_LINE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) -Wl,--gc-sections $(PARSE_LINE_CMOCKA_OBJS) $(CMOCKA_LIBS)

# conf_reattach tests - after a rehash, a registered server link is put
# under the new Connect block that admits it (same name, its recorded host
# or address, its SSL fingerprint), or keeps the one it linked under; the
# ConfItem and class reference counts follow, and no block another link
# holds is freed.  Includes ../s_conf.c, compiled with -ffunction-sections
# and linked with --gc-sections: the program keeps rehash_reattach_server()
# and the conf code it calls, so only those are stubbed in the test.
conf_reattach_cmocka.o: ${srcdir}/conf_reattach_cmocka.c ../s_conf.c
	${CC} ${CFLAGS} -ffunction-sections -fdata-sections ${CPPFLAGS} -c -o $@ ${srcdir}/conf_reattach_cmocka.c

CONF_REATTACH_CMOCKA_OBJS = conf_reattach_cmocka.o ../ircd_string.o ../match.o \
	../ircd_snprintf.o
conf_reattach_cmocka: $(CONF_REATTACH_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) -Wl,--gc-sections $(CONF_REATTACH_CMOCKA_OBJS) $(CMOCKA_LIBS)

# send_label tests - labeled-response (issue #216): a channel event a
# client's own command caused (its PART, TOPIC, KICK, MODE) carries the
# command's label, or its labeled batch, on that client's copy alone --
# not on a bouncer sibling's; a message a client sent itself is delivered
# without the label and outside the batch.  Includes ../send.c, compiled
# with -ffunction-sections and linked with --gc-sections: the program
# keeps the functions under test and what they call, so only those are
# stubbed in the test, and every line sent is captured at msgq_add().
# ../ircd_snprintf.o formats the lines (%C, %H, %v).
send_label_cmocka.o: ${srcdir}/send_label_cmocka.c ../send.c
	${CC} ${CFLAGS} -ffunction-sections -fdata-sections ${CPPFLAGS} -c -o $@ ${srcdir}/send_label_cmocka.c

SEND_LABEL_CMOCKA_OBJS = send_label_cmocka.o ../ircd_snprintf.o ../ircd_string.o
send_label_cmocka: $(SEND_LABEL_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) -Wl,--gc-sections $(SEND_LABEL_CMOCKA_OBJS) $(CMOCKA_LIBS)

# ml_discard tests - an open client multiline batch never ended: its label
# answered when draft/multiline goes inert, its lines freed with the
# Connection.  Includes ../m_batch.c, compiled with -ffunction-sections and
# linked with --gc-sections (as send_label_cmocka does with send.c).
ml_discard_cmocka.o: ${srcdir}/ml_discard_cmocka.c ../m_batch.c
	${CC} ${CFLAGS} -ffunction-sections -fdata-sections ${CPPFLAGS} -c -o $@ ${srcdir}/ml_discard_cmocka.c

ML_DISCARD_CMOCKA_OBJS = ml_discard_cmocka.o ../ircd_string.o
ml_discard_cmocka: $(ML_DISCARD_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) -Wl,--gc-sections $(ML_DISCARD_CMOCKA_OBJS) $(CMOCKA_LIBS)

.c.o:
	${CC} ${CFLAGS} ${CPPFLAGS} -c $< -o $@

.PHONY: distclean clean test test-cmocka test-all cmocka

# Run legacy unit tests (default - runs during Docker build)
test: ${TESTPROGS}
	@echo "Running nefarious unit tests..."
	@failed=0; \
	for t in ${TESTPROGS}; do \
		echo "  Running $$t..."; \
		if ./$$t > $$t.log 2>&1; then \
			echo "    PASSED"; \
		else \
			echo "    FAILED (exit code $$?)"; \
			cat $$t.log; \
			failed=1; \
		fi; \
	done; \
	if [ $$failed -eq 0 ]; then \
		echo "All unit tests passed."; \
	else \
		echo "Some tests failed!"; \
		exit 1; \
	fi

# Run CMocka tests (requires libcmocka-dev)
test-cmocka: ${CMOCKA_TESTPROGS}
	@echo "Running CMocka unit tests..."
	@failed=0; \
	for t in ${CMOCKA_TESTPROGS}; do \
		echo "  Running $$t..."; \
		./$$t > $$t.log 2>&1; rc=$$?; \
		cat $$t.log; \
		if [ $$rc -ne 0 ]; then \
			failed=1; \
		fi; \
	done; \
	if [ $$failed -ne 0 ]; then \
		echo "Some CMocka tests failed!"; \
		exit 1; \
	fi

# Run all tests (legacy + CMocka)
test-all: test test-cmocka
	@echo "All tests completed."

distclean: clean
	rm -f Makefile

clean:
	rm -f core *.o *.log ${TESTPROGS} ${CMOCKA_TESTPROGS}

