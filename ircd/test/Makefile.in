# crdt_hlc tests - the HLC_MAX_FORWARD_MS bound on hlc_receive_bounded.
# Links the real crdt_hlc.o (built by the top-level `make` before this
# runs); test_stub.o supplies log_write for the overflow warning path.
CRDT_HLC_CMOCKA_OBJS = crdt_hlc_cmocka.o test_stub.o ../crdt_hlc.o ../ircd_string.o
crdt_hlc_cmocka: $(CRDT_HLC_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(CRDT_HLC_CMOCKA_OBJS) $(CMOCKA_LIBS)

# db_api tests - storage API spec (bounded iterators, range delete, a
# compaction hint), run against two backends from the SAME test source
# (db_api_cmocka.c) so the fake cannot drift from RocksDB:
#   db_api_fake_cmocka    - the plain compile, links the in-memory fake
#                           (fake_db.o, ircd/test/fake_db.h); no RocksDB.
#   db_api_rocksdb_cmocka - the -DDB_API_REAL compile (its own .o, since
#                           the flag changes the binary), links the real
#                           RocksDB backend (../db_rocksdb.o) against a
#                           mkdtemp()'d env; test_stub.o supplies
#                           log_write, and ../ircd_snprintf.o/../ircd_alloc.o/
#                           ../ircd_string.o are the real backend's own deps.
DB_API_FAKE_CMOCKA_OBJS = db_api_cmocka.o fake_db.o
db_api_fake_cmocka: $(DB_API_FAKE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(DB_API_FAKE_CMOCKA_OBJS) $(CMOCKA_LIBS)

db_api_cmocka_real.o: ${srcdir}/db_api_cmocka.c
	${CC} ${CFLAGS} ${CPPFLAGS} -DDB_API_REAL -c -o $@ ${srcdir}/db_api_cmocka.c

DB_API_ROCKSDB_CMOCKA_OBJS = db_api_cmocka_real.o test_stub.o ../db_rocksdb.o \
	../ircd_alloc.o ../ircd_string.o ../ircd_snprintf.o
db_api_rocksdb_cmocka: $(DB_API_ROCKSDB_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(DB_API_ROCKSDB_CMOCKA_OBJS) $(CMOCKA_LIBS) $(ROCKSDB_LIBS)
