top_srcdir = @top_srcdir@
srcdir = @srcdir@
VPATH = @srcdir@
CPPFLAGS = -I${top_srcdir}/include -I../..
CFLAGS   = -g -Wall
LDFLAGS  =
CC = @CC@

# Legacy test programs (print-based, no assertions)
TESTPROGS = \
	ircd_chattr_t \
	ircd_in_addr_t \
	ircd_match_t \
	ircd_string_t

# CMocka test programs (proper assertions)
#
# @KC_CMOCKA_TESTPROGS@ is kc_url_cmocka kc_base64_cmocka kc_cache_cmocka
# kc_jwt_cmocka kc_cred_derive_cmocka kc_error_classify_cmocka under
# --enable-keycloak, and empty otherwise: those six link ../kc/*.o, which
# ircd/Makefile only builds when Keycloak is enabled (see configure.in's
# Keycloak block).  Their build rules stay defined below either way; they
# are simply never requested.
CMOCKA_TESTPROGS = \
	@KC_CMOCKA_TESTPROGS@ \
	ircd_chattr_cmocka \
	ircd_match_cmocka \
	ircd_string_cmocka \
	numnicks_cmocka \
	ircd_in_addr_cmocka \
	ircd_compress_cmocka \
	ircd_cloaking_cmocka \
	dbuf_cmocka \
	ircd_crypt_cmocka \
	crule_cmocka \
	history_cmocka \
	chathistory_presence_cmocka \
	recv_classify_cmocka

CMOCKA_LIBS = -lcmocka
ZSTD_LIBS = -lzstd
CURL_LIBS = -lcurl
JANSSON_LIBS = -ljansson
SSL_LIBS = -lssl -lcrypto

DEP_SRC = \
	ircd_chattr_t.c \
	ircd_in_addr_t.c \
	ircd_match_t.c \
	ircd_string_t.c \
	ircd_chattr_cmocka.c \
	ircd_match_cmocka.c \
	ircd_string_cmocka.c \
	numnicks_cmocka.c \
	ircd_in_addr_cmocka.c \
	ircd_compress_cmocka.c \
	ircd_cloaking_cmocka.c \
	dbuf_cmocka.c \
	ircd_crypt_cmocka.c \
	crule_cmocka.c \
	history_cmocka.c \
	chathistory_presence_cmocka.c \
	recv_classify_cmocka.c \
	kc_url_cmocka.c \
	kc_base64_cmocka.c \
	kc_cache_cmocka.c \
	kc_jwt_cmocka.c \
	kc_cred_derive_cmocka.c \
	kc_error_classify_cmocka.c \
	test_stub.c

all: ${TESTPROGS}

build: ${TESTPROGS}

# Build CMocka tests separately (requires libcmocka-dev)
cmocka: ${CMOCKA_TESTPROGS}

depend: ${DEP_SRC}
	@cd ${srcdir} && \
	if [ -f Makefile.in.bak ]; then \
	  echo "make depend: First remove ircd/Makefile.in.bak"; \
	else \
	  mv Makefile.in Makefile.in.bak && \
	  grep -A1 -B10000 '^# DO NOT DELETE THIS LINE' Makefile.in.bak > Makefile.in && \
	  ${CC} ${CFLAGS} -MM ${CPPFLAGS} ${DEP_SRC} >> Makefile.in; \
	fi

install:

IRCD_CHATTR_T_OBJS = ircd_chattr_t.o test_stub.o ../ircd_string.o
ircd_chattr_t: $(IRCD_CHATTR_T_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_CHATTR_T_OBJS)

IRCD_IN_ADDR_T_OBJS = ircd_in_addr_t.o test_stub.o ../ircd_alloc.o ../ircd_string.o ../match.o ../numnicks.o
ircd_in_addr_t: $(IRCD_IN_ADDR_T_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_IN_ADDR_T_OBJS)

IRCD_MATCH_T_OBJS = ircd_match_t.o test_stub.o ../ircd_string.o ../match.o
ircd_match_t: $(IRCD_MATCH_T_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_MATCH_T_OBJS)

IRCD_STRING_T_OBJS = ircd_string_t.o test_stub.o ../ircd_string.o
ircd_string_t: $(IRCD_STRING_T_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_STRING_T_OBJS)

# CMocka tests - these use proper assertions
# All CMocka tests need test_stub.o for log_write/log_inassert stubs
IRCD_CHATTR_CMOCKA_OBJS = ircd_chattr_cmocka.o test_stub.o ../ircd_string.o
ircd_chattr_cmocka: $(IRCD_CHATTR_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_CHATTR_CMOCKA_OBJS) $(CMOCKA_LIBS)

IRCD_MATCH_CMOCKA_OBJS = ircd_match_cmocka.o test_stub.o ../ircd_string.o ../match.o
ircd_match_cmocka: $(IRCD_MATCH_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_MATCH_CMOCKA_OBJS) $(CMOCKA_LIBS)

IRCD_STRING_CMOCKA_OBJS = ircd_string_cmocka.o test_stub.o ../ircd_string.o
ircd_string_cmocka: $(IRCD_STRING_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_STRING_CMOCKA_OBJS) $(CMOCKA_LIBS)

NUMNICKS_CMOCKA_OBJS = numnicks_cmocka.o test_stub.o ../numnicks.o ../ircd_string.o ../ircd_alloc.o ../match.o
numnicks_cmocka: $(NUMNICKS_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(NUMNICKS_CMOCKA_OBJS) $(CMOCKA_LIBS)

IRCD_IN_ADDR_CMOCKA_OBJS = ircd_in_addr_cmocka.o test_stub.o ../ircd_string.o ../match.o ../numnicks.o ../ircd_alloc.o
ircd_in_addr_cmocka: $(IRCD_IN_ADDR_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_IN_ADDR_CMOCKA_OBJS) $(CMOCKA_LIBS)

# ircd_compress tests - requires zstd library
IRCD_COMPRESS_CMOCKA_OBJS = ircd_compress_cmocka.o test_stub.o ../ircd_compress.o
ircd_compress_cmocka: $(IRCD_COMPRESS_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_COMPRESS_CMOCKA_OBJS) $(CMOCKA_LIBS) $(ZSTD_LIBS)

# ircd_cloaking tests - uses #include .c approach to access static functions
# Links against ircd_md5.o for MD5 hashing used in cloaking
IRCD_CLOAKING_CMOCKA_OBJS = ircd_cloaking_cmocka.o test_stub.o ../ircd_md5.o ../ircd_string.o
ircd_cloaking_cmocka: $(IRCD_CLOAKING_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_CLOAKING_CMOCKA_OBJS) $(CMOCKA_LIBS)

# dbuf tests - inlines dbuf.c with stubs for feature_int/bool/flush_connections
DBUF_CMOCKA_OBJS = dbuf_cmocka.o test_stub.o ../ircd_string.o
dbuf_cmocka: $(DBUF_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(DBUF_CMOCKA_OBJS) $(CMOCKA_LIBS)

# ircd_crypt tests - password hashing mechanisms
IRCD_CRYPT_CMOCKA_OBJS = ircd_crypt_cmocka.o test_stub.o ../ircd_string.o ../ircd_md5.o
ircd_crypt_cmocka: $(IRCD_CRYPT_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(IRCD_CRYPT_CMOCKA_OBJS) $(CMOCKA_LIBS)

# crule tests - connection rule parser (uses CR_DEBUG mode, includes crule.c)
CRULE_CMOCKA_OBJS = crule_cmocka.o test_stub.o ../ircd_string.o
crule_cmocka: $(CRULE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(CRULE_CMOCKA_OBJS) $(CMOCKA_LIBS)

# history tests - serialization functions (no LMDB required)
HISTORY_CMOCKA_OBJS = history_cmocka.o test_stub.o ../ircd_string.o
history_cmocka: $(HISTORY_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(HISTORY_CMOCKA_OBJS) $(CMOCKA_LIBS)

# chathistory_presence tests - links the REAL chathistory_presence.o (built
# by the top-level `make` before this runs, same as ../ircd_string.o et al)
# to regression-test the uint8_t presence_record.count overflow fix
# (F-CH3).  db_*/history_get_env/feature_int/feature_bool are stubbed
# in chathistory_presence_cmocka.c itself since the in-memory
# session-anchored path under test never reaches the persistence layer.
CHATHISTORY_PRESENCE_CMOCKA_OBJS = chathistory_presence_cmocka.o test_stub.o ../chathistory_presence.o ../ircd_alloc.o ../ircd_string.o
chathistory_presence_cmocka: $(CHATHISTORY_PRESENCE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(CHATHISTORY_PRESENCE_CMOCKA_OBJS) $(CMOCKA_LIBS)

# recv_classify tests - per-class recv-path byte classifier
RECV_CLASSIFY_CMOCKA_OBJS = recv_classify_cmocka.o test_stub.o ../recv_classify.o
recv_classify_cmocka: $(RECV_CLASSIFY_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(RECV_CLASSIFY_CMOCKA_OBJS) $(CMOCKA_LIBS)

# kc_url tests - vendored libkc URL builders.  kc_url.c calls
# curl_easy_escape in kc_url_group_by_path, hence -lcurl.  The test
# stubs kc_get_log_ops itself so kc.o (and the whole HTTP stack) stays
# out of the link.
KC_URL_CMOCKA_OBJS = kc_url_cmocka.o ../kc/kc_url.o
kc_url_cmocka: $(KC_URL_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(KC_URL_CMOCKA_OBJS) $(CMOCKA_LIBS) $(CURL_LIBS)

# kc_base64 tests - vendored libkc base64 codec (no libkc deps)
KC_BASE64_CMOCKA_OBJS = kc_base64_cmocka.o ../kc/kc_base64.o
kc_base64_cmocka: $(KC_BASE64_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(KC_BASE64_CMOCKA_OBJS) $(CMOCKA_LIBS)

# kc_cache tests - vendored libkc user-id and user-representation caches
KC_CACHE_CMOCKA_OBJS = kc_cache_cmocka.o ../kc/kc_cache.o
kc_cache_cmocka: $(KC_CACHE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(KC_CACHE_CMOCKA_OBJS) $(CMOCKA_LIBS) $(JANSSON_LIBS)

# kc_jwt tests - claim policy (F-K3 exp/nbf).  Uses the #include .c
# approach to reach static jwt_parse_claims, so ../kc/kc_jwt.o must NOT
# be linked (duplicate symbols).  kc_http_sync.o satisfies the JWKS
# fetch reference, which no test actually calls.
KC_JWT_CMOCKA_OBJS = kc_jwt_cmocka.o ../kc/kc_base64.o ../kc/kc_http_sync.o
kc_jwt_cmocka: $(KC_JWT_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(KC_JWT_CMOCKA_OBJS) $(CMOCKA_LIBS) $(JANSSON_LIBS) $(CURL_LIBS) $(SSL_LIBS)

# kc_cred_derive tests - registration-time SCRAM-SHA-256 + Keycloak PBKDF2
# credential derivation.  Pure derivation code (no HTTP), so only
# kc_base64.o is needed alongside kc_cred_derive.o itself.
KC_CRED_DERIVE_CMOCKA_OBJS = kc_cred_derive_cmocka.o ../kc/kc_cred_derive.o ../kc/kc_base64.o
kc_cred_derive_cmocka: $(KC_CRED_DERIVE_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(KC_CRED_DERIVE_CMOCKA_OBJS) $(CMOCKA_LIBS) $(JANSSON_LIBS) $(SSL_LIBS)

# kc_error_classify tests - ROPC 400/401 grant-error body classifier
# (KC_UNVERIFIED vs KC_FORBIDDEN). Pure jansson logic, no HTTP.
KC_ERROR_CLASSIFY_CMOCKA_OBJS = kc_error_classify_cmocka.o ../kc/kc_error_classify.o
kc_error_classify_cmocka: $(KC_ERROR_CLASSIFY_CMOCKA_OBJS)
	${CC} -o $@ $(LDFLAGS) $(KC_ERROR_CLASSIFY_CMOCKA_OBJS) $(CMOCKA_LIBS) $(JANSSON_LIBS)

.c.o:
	${CC} ${CFLAGS} ${CPPFLAGS} -c $< -o $@

.PHONY: distclean clean test test-cmocka test-all cmocka

# Run legacy unit tests (default - runs during Docker build)
test: ${TESTPROGS}
	@echo "Running nefarious unit tests..."
	@failed=0; \
	for t in ${TESTPROGS}; do \
		echo "  Running $$t..."; \
		if ./$$t > $$t.log 2>&1; then \
			echo "    PASSED"; \
		else \
			echo "    FAILED (exit code $$?)"; \
			cat $$t.log; \
			failed=1; \
		fi; \
	done; \
	if [ $$failed -eq 0 ]; then \
		echo "All unit tests passed."; \
	else \
		echo "Some tests failed!"; \
		exit 1; \
	fi

# Run CMocka tests (requires libcmocka-dev)
test-cmocka: ${CMOCKA_TESTPROGS}
	@echo "Running CMocka unit tests..."
	@failed=0; \
	for t in ${CMOCKA_TESTPROGS}; do \
		echo "  Running $$t..."; \
		./$$t > $$t.log 2>&1; rc=$$?; \
		cat $$t.log; \
		if [ $$rc -ne 0 ]; then \
			failed=1; \
		fi; \
	done; \
	if [ $$failed -ne 0 ]; then \
		echo "Some CMocka tests failed!"; \
		exit 1; \
	fi

# Run all tests (legacy + CMocka)
test-all: test test-cmocka
	@echo "All tests completed."

distclean: clean
	rm -f Makefile

clean:
	rm -f core *.o *.log ${TESTPROGS} ${CMOCKA_TESTPROGS}

# DO NOT DELETE THIS LINE (or the blank line after it) -- make depend depends on them.

ircd_chattr_t.o: ircd_chattr_t.c ../../include/ircd_chattr.h
ircd_in_addr_t.o: ircd_in_addr_t.c ../../include/ircd_log.h \
  ../../include/ircd_string.h ../../include/ircd_chattr.h \
  ../../include/numnicks.h ../../include/client.h \
  ../../include/ircd_defs.h ../../include/dbuf.h ../../include/msgq.h \
  ../../include/ircd_events.h ../../config.h ../../include/ircd_handler.h \
  ../../include/res.h ../../include/capab.h ../../include/res.h
ircd_match_t.o: ircd_match_t.c ../../include/ircd_log.h \
  ../../include/match.h ../../include/res.h ../../config.h
ircd_string_t.o: ircd_string_t.c ../../include/ircd_string.h \
  ../../include/ircd_chattr.h
test_stub.o: test_stub.c ../../include/client.h ../../include/ircd_defs.h \
  ../../include/dbuf.h ../../include/msgq.h ../../include/ircd_events.h \
  ../../config.h ../../include/ircd_handler.h ../../include/res.h \
  ../../include/capab.h ../../include/ircd_log.h ../../include/s_debug.h
